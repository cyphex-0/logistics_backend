# Server Configuration
PORT=3000
NODE_ENV=development
NODE_VERSION=20

# Database
DATABASE_URL=
# Example: postgresql://username:password@host:5432/dbname?schema=public

# Security & Authentication
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis
REDIS_URL=

# Stripe Integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# bKash Integration
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=

# Admin Seed Credentials
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# CORS
CORS_ORIGIN=
# Example: https://frontend.example.com
