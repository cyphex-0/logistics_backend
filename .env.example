# Server Configuration
PORT=3000
NODE_ENV=development
NODE_VERSION=20

# Database
DATABASE_URL=
# Example: postgresql://username:password@host:5432/dbname?schema=public

# Security & Authentication
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis
REDIS_URL=

# Stripe Integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# bKash Integration
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=

# Admin Seed Credentials
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# CORS
CORS_ORIGIN=
# Example: https://frontend.example.com

# AI Support Chatbot (Gemini API & OpenRouter Fallback)
# Server-side only: never expose GEMINI_API_KEY or OPENROUTER_API_KEY to client bundles
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_SUPPORT_ENABLED=true
SUPPORT_EMAIL=

# OpenRouter Secondary Fallback (Optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

